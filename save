/*
  Prog -->  ListaDecl

  ListaDecl -->  DeclVar  ListaDecl
              |  DeclFun  ListaDecl
              |  // vazio

  DeclVar --> Tipo ListaIdent ';' DeclVar
            | // vazio

  Tipo --> int | double | boolean

  ListaIdent --> IDENT , ListaIdent  
               | IDENT      

  DeclFun --> FUNC tipoOuVoid IDENT '(' FormalPar ')' '{' DeclVar ListaCmd '}' DeclFun
            | // vazio

  TipoOuVoid --> Tipo | VOID

  // Formal par é inútil, a análise pode ser feita sem ele e ir direto pra paramlist e tratar da mesma forma que lista Ident
  // caso contrário, é necessário analisar (vazio) que não significa nada
  FormalPar -> paramList  
            | // vazio

  paramList --> Tipo IDENT , ParamList
              | Tipo IDENT 

  Bloco --> { ListaCmd }

  ListaCmd --> Cmd ListaCmd
    |    // vazio

  Cmd --> Bloco
      | while ( E ) Cmd
      | IDENT = E ;
      | if ( E ) Cmd RestoIf

  RestoIf -> else Cmd
        |    // vazio
  E --> E + T
      | E - T
      | T

  T --> T * F
      | T / F
      | F    
      
  F -->  IDENT
      | NUM
      | ( E )
*/

static int laToken;

static void yyerror(const char *s);

static bool check(int token);
static bool declVar(void);
static bool listaIdent(void);

static bool declFunc(void);
static bool tipoOuVoid(void);
static bool paramList(void);

static bool listaCmd(void);
static bool cmd(void);

static void yyerror(const char *s)
{
    fprintf(stderr, "Error: %s\n", s);
    exit(EXIT_FAILURE);
}

static bool check(int token)
{
    if (laToken == token) {
        if(laToken != TEOF)
            laToken = yylex();
        return true;
    }

    printf("Error: expected token %d, but got %d\n", token, laToken);
    return false;
}

static bool listaIdent(void)
{
    if (!check(IDENT)) return false;

    while (check(',')) {
        if (!check(IDENT)) return false;
    }

    return true;
}

static bool declVar(void)
{
    // check if it is a var
    if(!check(TYPE)) return false;

    if(!listaIdent()) 
    {
        yyerror("Error in listaIdent");
        return false;
    }

    if(!check(';')) 
    {
        yyerror("Error in declVar");
        return false;
    }

    return true;
}

static bool tipoOuVoid(void)
{
    // check if it is a type or void
    if (check(TYPE)) return true;
    if (check(VOID)) return true;

    yyerror("Error: expected TYPE or VOID");
    return false;
}

static bool paramList(void)
{
    // check if it follows the start pattern of a parameter list (could be empty)
    if (!tipoOuVoid()) return false;

    if (!check(IDENT)) 
    {
        yyerror("Error in paramList, expected IDENT");
        return false;
    }

    if(check(','))
    {
        if (!paramList()) 
        {
            yyerror("Error in paramList, expected more parameters");
            return false;
        }
    }

    return true;
}

static bool cmd(void)
{
    
}

static bool listaCmd(void)
{
    while(cmd());

    return true;
}

static bool declFunc(void)
{
    // check if it is a function declaration
    if(!check(FUNC)) return false;

    if(!tipoOuVoid()) 
    {
        yyerror("Error in declFunc, expected TYPE or VOID");
        return false;
    }

    if(!check(IDENT))
    {
        yyerror("Error in declFunc, expected IDENT");
        return false;
    }

    if(!check('('))
    {
        yyerror("Error in declFunc, expected '('");
        return false;
    }
    
    if(!paramList())
    {
        yyerror("Error in declFunc, expected parameter list");
        return false;
    }

    if(!check(')')) return false;
    if(!check('{')) return false;

    while(declVar() || listaCmd());

    if(!check('}')) return false;
}

void prog(void)
{   
    laToken = yylex();

    while(declVar() || declFunc());

    if(!check(TEOF))
        printf("Error: expected EOF\n");

    printf("\nEOF\n");

    return;
}